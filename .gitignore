# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
release/

# Gradle files
.gradle/
.gradle

# Local configuration file (sdk path, etc)
local.properties

