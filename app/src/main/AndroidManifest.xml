<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Onboarding-listed permissions (each declared with explicit purpose) ===== -->

    <!-- ====== 定位权限（仅前台定位） ====== -->
    <!-- 粗略定位：基于基站/WiFi/IP，室内可用，Android 12+ 必须同时声明 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 精确定位：基于 GPS，室外可用 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- [修改点] 明确声明：不使用后台定位。
         国产 ROM（HyperOS/ColorOS/OriginOS/MagicOS）申请 ACCESS_BACKGROUND_LOCATION
         会连带限制前台定位回调，故严禁声明。仅做前台定位。 -->
    <!-- <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" /> -->

    <!-- [修改点] 定位硬件特性声明（required=false，允许无 GPS 设备安装）。
         GPS_PROVIDER 依赖 android.hardware.location.gps；
         NETWORK_PROVIDER 依赖 android.hardware.location.network。 -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- 通讯录权限：读取紧急联系人 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 闹钟与提醒：服药提醒、透析时间闹钟 (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 存储权限：保存健康数据、导出报告 (Android 13+ 分区化媒体权限) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 后台强提醒：锁屏/后台状态下全屏提醒服药和透析 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 电话权限：一键拨打主治医生/紧急联系人 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- 应用列表读取：仅声明，运行时通过 QUERY_ALL_PACKAGES 政策受限，不上架普通应用商店 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".ClearDuApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClearDu"
        tools:targetApi="34">

        <activity
            android:name=".OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.ClearDu.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.ClearDu" />

        <activity
            android:name=".DataRecordActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.ClearDu"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".HealthDataActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.ClearDu"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MedicationActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.ClearDu"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ReminderActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.ClearDu"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
